# Archivo de ejemplo de variables de entorno para Acestream Docker Home
# Este archivo es OPCIONAL. SetupAcestream.bat genera automaticamente la
# configuracion necesaria al ejecutarse en Windows.
# Copiar a .env y modificar solo si se necesita personalizar valores.

# IP interna usada por el reproductor y el motor Acestream.
# En Windows, SetupAcestream.bat la detecta automaticamente.
# Ejemplo: 192.168.1.100
INTERNAL_IP=127.0.0.1

# Puerto HTTP para el motor Acestream (por defecto 6878).
# Si se cambia, asegurarse de que no este en uso.
HTTP_PORT=6878

# Puerto HTTPS para el motor Acestream (siempre HTTP_PORT + 1).
# Si HTTP_PORT es 6878, HTTPS_PORT debe ser 6879.
HTTPS_PORT=6879

# Banderas extra pasadas al script start-engine de Acestream.
# Usado internamente por el perfil memory para activar cache en RAM.
# Ejemplo: --live-cache-type memory
ACESTREAM_EXTRA_FLAGS=

# Idioma del script de instalacion de Windows: es (espanol) o en (ingles).
# Si no esta definido, el script muestra un menu con 5 segundos de espera
# y el valor predeterminado es espanol.
SETUP_LANG=es

# Eliminar imagenes obsoletas de Docker despues de descargar la nueva: true o false.
# Util para liberar espacio en disco tras actualizaciones de la imagen.
SETUP_AUTO_CLEAN=false
