# Acestream Docker Home — Environment Variables Example
# This file is OPTIONAL. SetupAcestream.bat auto-generates configuration
# when run on Windows.
# Copy to .env and modify only if you need to customize values.
#
# NOTE: SetupAcestream.bat handles its Windows options via command-line
# arguments (--lang, --auto-clean), NOT environment variables.

# ─── Docker / Acestream Engine Variables ──────────────────────────────────────

# Internal IP used by the player and the Acestream engine.
# On Windows, SetupAcestream.bat auto-detects this.
# Example: 192.168.1.100
INTERNAL_IP=127.0.0.1

# HTTP port for the Acestream engine (default 6878).
# If changed, make sure it is not already in use.
HTTP_PORT=6878

# HTTPS port for the Acestream engine (always HTTP_PORT + 1).
# If HTTP_PORT is 6878, HTTPS_PORT must be 6879.
HTTPS_PORT=6879

# Extra flags passed to the Acestream start-engine script.
# Used internally by the memory profile to enable RAM cache.
# Example: --live-cache-type memory
ACESTREAM_EXTRA_FLAGS=
