# Acestream Docker Home — Environment Variables Example
# OPTIONAL. Only used by the repo's docker-compose.yml (manual / Linux / macOS
# runs). SetupAcestream.bat generates its own acestream-compose.yml on Windows
# and takes its options as command-line flags (--lang, --auto-clean,
# --unattended), not from this file.
#
# Copy to .env next to docker-compose.yml and change only what you need.

# Docker image to run (default: the published image).
# Example for a local build: ACESTREAM_IMAGE=acestream-engine:latest
ACESTREAM_IMAGE=smarquezp/docker-acestream-ubuntu-home:latest

# HTTP port for the engine and the web player (default 6878).
# It is published on the same port on the host.
HTTP_PORT=6878

# HTTPS port passed to the engine; must always be HTTP_PORT + 1.
HTTPS_PORT=6879

# Extra flags appended to the engine command line.
# The "memory" profile sets --live-cache-type memory by itself.
ACESTREAM_EXTRA_FLAGS=
